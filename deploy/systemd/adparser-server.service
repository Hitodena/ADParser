[Unit]
Description=AutoDealer Parser CSV HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@PROJECT_DIR@
ExecStart=@UV@ run -m src.server
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adparser-server

[Install]
WantedBy=multi-user.target
