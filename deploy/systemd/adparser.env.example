# Скопируйте в /etc/adparser/adparser.env и заполните значения.
# Права: chmod 600 /etc/adparser/adparser.env

# Путь к каталогу проекта (где лежат main.py, pyproject.toml)
ADPARSER_PROJECT_DIR=/opt/adparser

# Путь к uv (which uv)
ADPARSER_UV=/root/.local/bin/uv

# Учётные данные AutoDealer
ADPARSER_USERNAME=your@email.com
ADPARSER_PASSWORD=your_password

# CSV-сервер
ADPARSER_PORT=8000

# Планировщик парсинга
ADPARSER_SCHEDULE_TIME=02:00
ADPARSER_OUTPUT=output.csv
ADPARSER_OUTPUT_WAREHOUSE=warehouse.csv

# 1 — парсить склад вместе с услугами, 0 — только услуги
ADPARSER_WAREHOUSE=0

# Пользователь systemd (оставьте пустым, чтобы запускать от root)
# ADPARSER_USER=adparser
