[Unit]
Description=AutoDealer Parser daily scheduler
Documentation=file://@PROJECT_DIR@/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/adparser/adparser.env
WorkingDirectory=@PROJECT_DIR@
ExecStart=@DEPLOY_DIR@/run-scheduler.sh
Restart=always
RestartSec=30

# Раскомментируйте и укажите пользователя в adparser.env (ADPARSER_USER)
# User=@USER@
# Group=@USER@

StandardOutput=journal
StandardError=journal
SyslogIdentifier=adparser-scheduler

[Install]
WantedBy=multi-user.target
